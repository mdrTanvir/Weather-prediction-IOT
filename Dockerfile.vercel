FROM composer:2 AS dependencies

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

FROM php:8.3-apache

WORKDIR /var/www/html
COPY --from=dependencies /app/vendor ./vendor
COPY index.php average_temp_humid.php load_and_predict.php recordDeviceData.php ./
COPY Training_data/cleaned_training_data.csv ./Training_data/cleaned_training_data.csv
COPY Saved_models/ ./Saved_models/
COPY canvasjs3.6/canvasjs.min.js ./canvasjs3.6/canvasjs.min.js

EXPOSE 80
